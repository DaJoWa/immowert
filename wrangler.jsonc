// Konfiguration für Cloudflare Workers (Workers Builds).
// Baut die App mit Vite nach dist/ und liefert sie zusammen mit dem
// API-Proxy unter /api/claude aus.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "immowert",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
